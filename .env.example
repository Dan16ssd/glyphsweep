# Vultr Serverless Inference (console.vultr.com -> Serverless -> Inference -> API key)
VULTR_INFERENCE_API_KEY=
GS_MODEL=qwen3.8-27b
GS_VISION_MODEL=qwen3.8-27b
# Pages per sweep (start page + planner picks), concurrent jobs, sandbox wall-clock limit
GS_MAX_PAGES=3
GS_CONCURRENCY=2
GS_SANDBOX_TIMEOUT=240
# Leave empty to auto-detect gVisor (runsc); set to runc only for local testing
GS_RUNTIME=
# Public hostname for HTTPS (setup_vultr.sh fills <ip-with-dashes>.sslip.io); empty = plain HTTP on :80
GS_DOMAIN=
